
---
import Layout from "../layouts/Layout.astro";
import productos from "../data/productos.js";

const categorias = [
  "Todos",
  ...new Set(productos.map((p) => p.categoria))
];

const numeroWhatsApp = "5210000000000";
---

<Layout
  title="Cursos, retos, talleres y más | Mate Brillinury y Samuel"
  description="Explora nuestro catálogo de cursos, retos y talleres de matemáticas."
>
  <header class="py-3 border-bottom">
    <nav class="container d-flex flex-wrap justify-content-between align-items-center gap-3">
      <a class="navbar-brand fw-bold" href="/">
        Mate Brillinury y Samuel
      </a>
      <!--
      <a
        class="btn btn-outline-success"
        href={`https://wa.me/${numeroWhatsApp}`}
        target="_blank"
        rel="noopener noreferrer"
      >
        Contactar por WhatsApp
      </a>-->
    </nav>
  </header>

  <main>
    <section class="hero py-5">
      <div class="container py-4 text-center">
        <p class="text-uppercase fw-semibold mb-2">
          MATEMÁTICAS PURAS CON PASIÓN
        </p>
        <h1 class="display-4 fw-bold">
          Cursos, artículos, cuadernillos, glosarios
        </h1>
        <p class="lead mx-auto mt-3" style="max-width: 680px">
          Explora nuestros recursos y encuentra tu siguiente producto matemático.
        </p>
        
      </div>
    </section>

    <section id="catalogo" class="container py-5">
      <div class="d-flex flex-wrap justify-content-between align-items-center gap-3 mb-4">
        <div>
          <h2 class="fw-bold mb-1">Nuestro catálogo</h2>
          <p class="text-secondary mb-0">
            Consulta los detalles de cada producto.
          </p>
        </div>

        <label>
          <span class="visually-hidden">Filtrar por categoría</span>
          <select id="filtro" class="form-select">
            {categorias.map((categoria) => (
              <option value={categoria}>{categoria}</option>
            ))}
          </select>
        </label>
      </div>

      <div class="row g-4" id="productos">
        {productos.map((producto) => (
          <div
            class="col-12 col-sm-6 col-lg-4 producto"
            data-categoria={producto.categoria}
          >
            <article class="card h-100 shadow-sm">
              <img
                src={producto.imagen}
                class="card-img-top imagen-producto"
                alt={producto.nombre}
                loading="lazy"
              />

              <div class="card-body d-flex flex-column">
                <span class="badge text-bg-light align-self-start mb-2">
                  {producto.categoria}
                </span>

                <h3 class="h5 card-title">{producto.nombre}</h3>

                <p class="card-text text-secondary">
                  {producto.descripcion}
                </p>

                <p class="fs-5 fw-bold mt-auto">
                  {producto.precio}
                </p>

                <a
                  class="btn btn-dark"
                  href={producto.url}
                  target="_blank"
                  rel="noopener noreferrer"
                >
                  Más Info
                </a>
              </div>
            </article>
          </div>
        ))}
      </div>

      <p id="sin-resultados" class="text-secondary mt-4" hidden>
        No hay productos en esta categoría.
      </p>
    </section>
  </main>

  <footer class="py-4 border-top">
    <div class="container text-center text-secondary">
      Mate Brillinury y Samuel, todos los derechos reservados
    </div>
  </footer>

  <script>
    const filtro = document.querySelector("#filtro");
    const tarjetas = document.querySelectorAll(".producto");
    const aviso = document.querySelector("#sin-resultados");

    filtro?.addEventListener("change", () => {
      let visibles = 0;

      tarjetas.forEach((tarjeta) => {
        const coincide =
          filtro.value === "Todos" ||
          tarjeta.dataset.categoria === filtro.value;

        tarjeta.classList.toggle("d-none", !coincide);

        if (coincide) visibles++;
      });

      if (aviso) aviso.hidden = visibles !== 0;
    });
  </script>

  <style>
    .hero {
      background: #f7f2eb;
    }

    .imagen-producto {
      width: 100%;
      aspect-ratio: 1 / 1;
      object-fit: cover;
      background: #f7f7f7;
    }

    .card {
      border-radius: 14px;
      overflow: hidden;
    }

    .card .btn {
      width: 100%;
    }
  </style>
</Layout>
